generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id             String          @id @default(cuid())
  name           String
  visitCount     Int             @default(0)
  lastVisitDate  DateTime?
  notes          String?
  profile        CustomerProfile?
  visitRecords   VisitRecord[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model CustomerProfile {
  id                   String   @id @default(cuid())
  customerId           String   @unique
  customer             Customer @relation(fields: [customerId], references: [id])
  defaultDesign        String?
  preferredThickness   Int      @default(0)
  preferredAngle       Int      @default(0)
  preferredDensity     Int      @default(0)
  asymmetryType        String?
  asymmetryLevel       Int      @default(0)
  hairFlowNotes        String?
  sparseAreaNotes      String?
  skinRiskProfile      String?
  ngPoints             String?
  selfCareHabitNotes   String?
  generalHandoverNotes String?
  updatedAt            DateTime @updatedAt
}

model VisitRecord {
  id               String   @id @default(cuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  visitDate        DateTime @default(now())
  visitType        String   @default("repeat_visit")
  previousRecordId String?
  visitPolicy      String   @default("same_as_previous")
  changedFields    String?
  designPlan       String?
  todayObservation String?
  treatmentRecord  String?
  reaction         String?
  handover         String?
  aiPlaceholder    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
