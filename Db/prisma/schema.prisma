generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id               String          @id
  name             String
  nameKana         String?
  age              Int?
  phone            String?
  email            String?
  visitCount       Int             @default(0)
  lastVisitDate    DateTime?
  notes            String?
  profile          CustomerProfile?
  visitRecords     VisitRecord[]
  appointments     Appointment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model CustomerProfile {
  id                   String   @id @default(cuid())
  customerId           String   @unique
  customer             Customer @relation(fields: [customerId], references: [id])
  defaultDesign        String?
  preferredThickness   Int      @default(0)
  preferredAngle       Int      @default(0)
  preferredDensity     Int      @default(0)
  asymmetryType        String?
  asymmetryLevel       Int      @default(0)
  hairFlowNotes        String?
  sparseAreaNotes      String?
  skinRiskProfile      String?
  ngPoints             String?
  selfCareHabitNotes   String?
  generalHandoverNotes String?
  updatedAt            DateTime @updatedAt
}

model VisitRecord {
  treatmentId                   String   @id
  customerId                    String
  customer                      Customer @relation(fields: [customerId], references: [id])
  visitNumber                   Int
  visitDate                     DateTime @default(now())
  previousTreatmentId           String?
  visitType                     String   @default("repeat_visit")
  visitPolicy                   String   @default("same_as_previous")
  changedFields                 String?
  designPlan                    String?
  todayObservation              String?
  treatmentRecord               String?
  handover                      String?
  originalObservationMemo       String?
  aiGeneratedObservationSummary String?
  aiGeneratedHandover           String?
  staffEditedHandover           String?
  aiPlaceholder                 String?
  staffId                       String?
  staff                         Staff?   @relation(fields: [staffId], references: [id])
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model Staff {
  id           String        @id
  name         String
  visitRecords VisitRecord[]
  createdAt    DateTime      @default(now())
}

model Appointment {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  date          String   // "YYYY-MM-DD"
  time          String   // "HH:MM"
  status        String   @default("scheduled") // 'scheduled' | 'completed' | 'cancelled'
  visitRecordId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
